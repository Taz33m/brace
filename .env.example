# Copy to .env and fill in. Never commit .env.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides
BRACE_AGENT_MODEL=
BRACE_VISION_MODEL=
BRACE_AGENT_EFFORT=

# Explicit preparation-to-resident binding: property ID + scenario ID -> recovery case ID.
# Requires BRACE_RECOVERY_ENABLED=1 and authenticated owner approval.
BRACE_PREPARATION_CASES={}
# Optional JSON list of frozen recovery run directories to import at startup.
BRACE_RECOVERY_SEED_RUNS=[]
# Open the owner console directly from this machine's loopback browser.
BRACE_LOCAL_OWNER=0

# Optional stable Photon Spectrum iMessage integration.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
BRACE_PHOTON_BRIDGE_SECRET=
BRACE_PHOTON_BRIDGE_URL=http://127.0.0.1:8011
BRACE_PHOTON_LINE=
